*.DS_Store

# Exclude large model checkpoints (too large for GitHub)
models/*.pth
models/wandb_local.json

# Include ONNX (small enough for GitHub)
!models/mobilevit_v2.onnx
!models/mobilevit_v2.onnx.data

# Raw prediction masks (hundreds of PNGs — large in aggregate)
outputs/preds/

# Keep outputs summary/metrics if they exist
!outputs/evaluation_summary.json
!outputs/metrics/

